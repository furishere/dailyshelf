

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  MOVIE
  TV_SHOW
  BOOK
}

enum Status {
  WATCHLIST
  IN_PROGRESS
  COMPLETED
  DROPPED
}

model User {
  id String @id @default(cuid())

  username  String @unique
  email  String @unique
  password String
  bio String?

  profilePicture  String?
  profileBanner String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medias Media[]
  journals Journal[]
  collections Collection[]
}

model Media {
  id String @id @default(cuid())

  tmdbId Int?
  googleBookId String?
  imdbId String?

  title String
  originalTitle String?

  type MediaType

  description String?

  poster String?
  backdrop String?

  releaseDate DateTime?
  releaseYear Int?

  genres String[]

  language String?

  runtime Int?
  pages Int?
  seasons Int?
  episodes Int?

  author String?
  publisher String?
  isbn String?

  status Status @default(WATCHLIST)

  rating Int?

  favourite Boolean @default(false)

  review String?
  notes String?

  startedAt DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user User @relation(fields: [userId], references: [id])

  collectionsItems CollectionItem[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([tmdbId])
  @@index([imdbId])
  @@unique([userId, tmdbId]) 
  @@unique([userId, googleBookId])
  @@unique([userId, imdbId]) 
}

model Journal {
  id String @id @default(cuid())

  heading String?

  content String

  createdAt DateTime @default(now())

  userId String
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Collection {
  id String @id @default(cuid())

  name String

  createdAt DateTime @default(now())

  userId String
  user User @relation(fields: [userId], references: [id])

  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id String @id @default(cuid())

  collectionId String
  mediaId String

  collection Collection @relation(fields: [collectionId], references: [id])

  media Media @relation(fields: [mediaId], references: [id])

  @@unique([collectionId, mediaId])
  @@index([collectionId])
  @@index([mediaId])
}